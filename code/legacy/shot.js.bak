// shot.js —— 用 Playwright 驱动本机 Chrome 给问答页面截图
// 用法: NODE_PATH=<workspace>/node_modules node code/shot.js [port]
const { chromium } = require('playwright');
const fs = require('fs');
const path = require('path');

const PORT = process.argv[2] || '8000';
const ROOT = path.resolve(__dirname, '..');
const SHOTS = path.join(ROOT, 'shots');
fs.mkdirSync(SHOTS, { recursive: true });

const CASES = [
  { name: '01_首页_混合检索_跨公司全景题',
    q: '2026年上半年 顺丰控股 圆通速递 韵达股份 申通快递 的营业收入分别是多少？谁最高？',
    mode: 'hybrid' },
  { name: '02_答案与出处_单公司数值题',
    q: '顺丰控股2026年上半年的营业收入和归母净利润是多少？',
    mode: 'hybrid' },
  { name: '03_跨市场对比_单票收入',
    q: '中通快递和顺丰控股的单票收入分别是多少？差距多大？',
    mode: 'hybrid' },
  { name: '04_仅BM25召回对比',
    q: '各家快递公司2026年上半年的毛利率对比',
    mode: 'bm25' },
  { name: '05_仅向量召回对比',
    q: '快递行业价格战在2026年上半年有什么体现？',
    mode: 'vector' },
  { name: '06_表格类问题_经营活动现金流',
    q: '哪家公司2026年上半年经营活动产生的现金流量净额最高？',
    mode: 'hybrid' },
];

(async () => {
  const browser = await chromium.launch({ channel: 'chrome', headless: true });
  const ctx = await browser.newContext({
    viewport: { width: 1360, height: 1100 },
    deviceScaleFactor: 2,
    locale: 'zh-CN',
  });
  const page = await ctx.newPage();
  page.on('console', m => { if (m.type() === 'error') console.log('  [page error]', m.text()); });

  await page.goto(`http://127.0.0.1:${PORT}/`, { waitUntil: 'networkidle' });
  await page.waitForSelector('#cos .chip', { timeout: 20000 });
  await page.waitForTimeout(600);
  await page.screenshot({ path: path.join(SHOTS, '00_页面首页.png') });
  console.log('OK  00_页面首页.png');

  for (const c of CASES) {
    // 切检索模式
    await page.click(`#modes .chip[data-m="${c.mode}"]`);
    await page.fill('#q', c.q);
    await page.click('#go');
    // 等答案渲染出来
    await page.waitForFunction(
      () => document.querySelectorAll('#out .hit').length > 0,
      null, { timeout: 90000 });
    await page.waitForTimeout(900);
    // 只截「答案 + 出处 + 前几块召回」，控制高度便于阅读
    await page.evaluate(() => window.scrollTo(0, 0));
    await page.screenshot({
      path: path.join(SHOTS, c.name + '.png'),
      clip: await page.evaluate(() => {
        const h = document.querySelector('#out').getBoundingClientRect();
        const top = window.scrollY;
        return { x: 0, y: top, width: 1360, height: Math.min(1550, h.height + 330) };
      }),
    });
    console.log('OK  ' + c.name + '.png');
  }

  await browser.close();
})().catch(e => { console.error('FAILED', e); process.exit(1); });
