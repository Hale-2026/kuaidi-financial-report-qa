# 大体积数据不入库 —— 全部可由 run_all.sh 一键复现
# （来源 URL 与 SHA1 记在 data/manifest.json）
data/pdfs/
data/text/
data/model/
data/index/
data/chunks/chunks.jsonl
data/chunks/shards/

# 交付产物（由 run_all.sh / shot.sh / make_report.py / package.py 生成）
# —— 报告 PDF、页面截图、交付包作为作业附件单独提交，不进仓库。
#    ⚠️ 例外：课件第三课 P163 要求的**一页结论 PDF** 需在公开仓库可见，
#    故 run_all.sh 的 7/8 步会把 output/一页结论.pdf 复制到仓库根目录
#    （即 `一页结论.pdf`，不被本文件忽略）并入库。
dist/
output/
shots/
reports/

# 开发过程杂物（本地保留，不再跟踪）
code/push_github.sh
code/legacy/

# 运行日志与临时文件
*.log
*.part
data/_ping.txt

# 环境变量与密钥 —— key 只放 .env 里，绝不写进代码或提交
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp
